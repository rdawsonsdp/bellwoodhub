{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "regions": [
    "iad1"
  ],
  "crons": [
    {
      "path": "/api/cron/refresh",
      "schedule": "0 8 * * 1"
    },
    {
      "path": "/api/cron/agent-runs",
      "schedule": "0 12-22 * * *"
    },
    {
      "path": "/api/cron/needs-you",
      "schedule": "0 12 * * 1-5"
    },
    {
      "path": "/api/cron/ingest-calendar",
      "schedule": "0 */2 * * *"
    },
    {
      "path": "/api/cron/ingest-email",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/cron/embed-mail",
      "schedule": "7,22,37,52 * * * *"
    },
    {
      "path": "/api/cron/ops-watch",
      "schedule": "0 */1 * * *"
    },
    {
      "path": "/api/cron/sentinel",
      "schedule": "30 * * * *"
    },
    {
      "schedule": "0 11 * * *",
      "path": "/api/cron/triage"
    },
    {
      "schedule": "0 12-22 * * *",
      "path": "/api/cron/triage"
    }
  ]
}