# Copy to .env.local. With nothing set, the site runs on sample content and
# logs emails instead of sending them.

# Public address of the site (used for links in emails and metadata)
NEXT_PUBLIC_SITE_URL=http://localhost:3300

# Supabase — content, storage and staff login
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Resend — newsletter sign-ups and form notifications
RESEND_API_KEY=
RESEND_AUDIENCE_ID=
EMAIL_FROM="Village of Bellwood <website@example.org>"
# Where "report a problem" emails go when a category has no department email
FALLBACK_NOTIFY_EMAIL=

# Eat in Bellwood portal address
NEXT_PUBLIC_EAT_IN_BELLWOOD_URL=

# Set to 1 at launch to let search engines index the site
NEXT_PUBLIC_SITE_LIVE=
